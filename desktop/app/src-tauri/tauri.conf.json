{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phone Spy Guard",
  "version": "0.3.0",
  "identifier": "com.phonespyguard.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Phone Spy Guard",
        "width": 1120,
        "height": 780,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Phone Spy Guard",
    "shortDescription": "Finds stalkerware, remote-access tools and interception settings on your own PC.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "signCommand": {
        "cmd": "psg-codesign",
        "args": [
          "%1"
        ]
      },
      "digestAlgorithm": "sha256"
    }
  }
}
