{
  "description": "Bundles that must be accepted or rejected by both parsers. 'bundle' is the bundle text. 'nested' builds a rule whose condition is N nested 'not' nodes around one leaf; 'wide' builds an 'all' with N leaves.",
  "cases": [
    {
      "name": "minimal bundle",
      "bundle": "{\"version\":1,\"expires\":\"2099-01-01T00:00:00Z\",\"rules\":[]}",
      "accept": true
    },
    {
      "name": "not an object",
      "bundle": "[1,2,3]",
      "accept": false
    },
    {
      "name": "not json",
      "bundle": "version: 1",
      "accept": false
    },
    {
      "name": "no version",
      "bundle": "{\"expires\":\"2099-01-01T00:00:00Z\",\"rules\":[]}",
      "accept": false
    },
    {
      "name": "bad expiry",
      "bundle": "{\"version\":1,\"expires\":\"next year\",\"rules\":[]}",
      "accept": false
    },
    {
      "name": "no rules",
      "bundle": "{\"version\":1,\"expires\":\"2099-01-01T00:00:00Z\"}",
      "accept": false
    },
    {
      "name": "unknown severity",
      "bundle": "{\"version\":1,\"expires\":\"2099-01-01T00:00:00Z\",\"rules\":[{\"id\":\"R\",\"severity\":\"dire\",\"contribution\":\"risk\",\"when\":{\"fact\":\"a\",\"exists\":true}}]}",
      "accept": false
    },
    {
      "name": "unknown contribution",
      "bundle": "{\"version\":1,\"expires\":\"2099-01-01T00:00:00Z\",\"rules\":[{\"id\":\"R\",\"severity\":\"low\",\"contribution\":\"maybe\",\"when\":{\"fact\":\"a\",\"exists\":true}}]}",
      "accept": false
    },
    {
      "name": "rule without when",
      "bundle": "{\"version\":1,\"expires\":\"2099-01-01T00:00:00Z\",\"rules\":[{\"id\":\"R\",\"severity\":\"low\",\"contribution\":\"risk\"}]}",
      "accept": false
    },
    {
      "name": "unknown node such as code",
      "bundle": "{\"version\":1,\"expires\":\"2099-01-01T00:00:00Z\",\"rules\":[{\"id\":\"R\",\"severity\":\"low\",\"contribution\":\"risk\",\"when\":{\"exec\":\"rm -rf /\"}}]}",
      "accept": false
    },
    {
      "name": "unknown operator",
      "bundle": "{\"version\":1,\"expires\":\"2099-01-01T00:00:00Z\",\"rules\":[{\"id\":\"R\",\"severity\":\"low\",\"contribution\":\"risk\",\"when\":{\"fact\":\"a\",\"matches\":\".*\"}}]}",
      "accept": false
    },
    {
      "name": "case-insensitive severity and contribution",
      "bundle": "{\"version\":1,\"expires\":\"2099-01-01T00:00:00Z\",\"rules\":[{\"id\":\"R\",\"severity\":\"HIGH\",\"contribution\":\"Strong\",\"when\":{\"fact\":\"a\",\"exists\":true}}]}",
      "accept": true
    },
    {
      "name": "unknown top-level keys are ignored",
      "bundle": "{\"version\":1,\"expires\":\"2099-01-01T00:00:00Z\",\"rules\":[],\"comment\":\"hi\"}",
      "accept": true
    },
    {
      "name": "depth 16 is allowed",
      "nested": 16,
      "accept": true
    },
    {
      "name": "depth 17 is rejected",
      "nested": 17,
      "accept": false
    },
    {
      "name": "256 nodes are allowed",
      "wide": 255,
      "accept": true
    },
    {
      "name": "257 nodes are rejected",
      "wide": 256,
      "accept": false
    },
    {
      "name": "explains on an innocent rule",
      "bundle": "{\"version\": 1, \"expires\": \"2099-01-01T00:00:00Z\", \"rules\": [{\"id\": \"R\", \"severity\": \"low\", \"contribution\": \"innocent\", \"when\": {\"fact\": \"a\", \"exists\": true}, \"explains\": [\"A\", \"B\"]}]}",
      "accept": true
    },
    {
      "name": "explains null reads as empty",
      "bundle": "{\"version\": 1, \"expires\": \"2099-01-01T00:00:00Z\", \"rules\": [{\"id\": \"R\", \"severity\": \"low\", \"contribution\": \"innocent\", \"when\": {\"fact\": \"a\", \"exists\": true}, \"explains\": null}]}",
      "accept": true
    },
    {
      "name": "empty explains on a risk rule",
      "bundle": "{\"version\": 1, \"expires\": \"2099-01-01T00:00:00Z\", \"rules\": [{\"id\": \"R\", \"severity\": \"low\", \"contribution\": \"risk\", \"when\": {\"fact\": \"a\", \"exists\": true}, \"explains\": []}]}",
      "accept": true
    },
    {
      "name": "explains on a non-innocent rule",
      "bundle": "{\"version\": 1, \"expires\": \"2099-01-01T00:00:00Z\", \"rules\": [{\"id\": \"R\", \"severity\": \"low\", \"contribution\": \"strong\", \"when\": {\"fact\": \"a\", \"exists\": true}, \"explains\": [\"A\"]}]}",
      "accept": false
    },
    {
      "name": "explains that is not an array",
      "bundle": "{\"version\": 1, \"expires\": \"2099-01-01T00:00:00Z\", \"rules\": [{\"id\": \"R\", \"severity\": \"low\", \"contribution\": \"innocent\", \"when\": {\"fact\": \"a\", \"exists\": true}, \"explains\": \"A\"}]}",
      "accept": false
    },
    {
      "name": "explains with a non-string entry",
      "bundle": "{\"version\": 1, \"expires\": \"2099-01-01T00:00:00Z\", \"rules\": [{\"id\": \"R\", \"severity\": \"low\", \"contribution\": \"innocent\", \"when\": {\"fact\": \"a\", \"exists\": true}, \"explains\": [\"A\", 5]}]}",
      "accept": false
    },
    {
      "name": "explains with 64 entries",
      "bundle": "{\"version\": 1, \"expires\": \"2099-01-01T00:00:00Z\", \"rules\": [{\"id\": \"R\", \"severity\": \"low\", \"contribution\": \"innocent\", \"when\": {\"fact\": \"a\", \"exists\": true}, \"explains\": [\"R0\", \"R1\", \"R2\", \"R3\", \"R4\", \"R5\", \"R6\", \"R7\", \"R8\", \"R9\", \"R10\", \"R11\", \"R12\", \"R13\", \"R14\", \"R15\", \"R16\", \"R17\", \"R18\", \"R19\", \"R20\", \"R21\", \"R22\", \"R23\", \"R24\", \"R25\", \"R26\", \"R27\", \"R28\", \"R29\", \"R30\", \"R31\", \"R32\", \"R33\", \"R34\", \"R35\", \"R36\", \"R37\", \"R38\", \"R39\", \"R40\", \"R41\", \"R42\", \"R43\", \"R44\", \"R45\", \"R46\", \"R47\", \"R48\", \"R49\", \"R50\", \"R51\", \"R52\", \"R53\", \"R54\", \"R55\", \"R56\", \"R57\", \"R58\", \"R59\", \"R60\", \"R61\", \"R62\", \"R63\"]}]}",
      "accept": true
    },
    {
      "name": "explains with 65 entries",
      "bundle": "{\"version\": 1, \"expires\": \"2099-01-01T00:00:00Z\", \"rules\": [{\"id\": \"R\", \"severity\": \"low\", \"contribution\": \"innocent\", \"when\": {\"fact\": \"a\", \"exists\": true}, \"explains\": [\"R0\", \"R1\", \"R2\", \"R3\", \"R4\", \"R5\", \"R6\", \"R7\", \"R8\", \"R9\", \"R10\", \"R11\", \"R12\", \"R13\", \"R14\", \"R15\", \"R16\", \"R17\", \"R18\", \"R19\", \"R20\", \"R21\", \"R22\", \"R23\", \"R24\", \"R25\", \"R26\", \"R27\", \"R28\", \"R29\", \"R30\", \"R31\", \"R32\", \"R33\", \"R34\", \"R35\", \"R36\", \"R37\", \"R38\", \"R39\", \"R40\", \"R41\", \"R42\", \"R43\", \"R44\", \"R45\", \"R46\", \"R47\", \"R48\", \"R49\", \"R50\", \"R51\", \"R52\", \"R53\", \"R54\", \"R55\", \"R56\", \"R57\", \"R58\", \"R59\", \"R60\", \"R61\", \"R62\", \"R63\", \"R64\"]}]}",
      "accept": false
    }
  ]
}
