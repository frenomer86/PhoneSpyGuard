{
  "description": "Shared scoring conformance cases. Both the Kotlin DetectionEngine and the Rust psg-core engine must produce exactly these verdicts for scoring-bundle.json. An INNOCENT rule explains only the rule ids in its 'explains' list; the verdict is taken from the unexplained signals; CONFIRM is never explained.",
  "bundle": "scoring-bundle.json",
  "cases": [
    {
      "name": "nothing matches",
      "facts": {
        "app.package": "com.example.notes"
      },
      "confidence": "UNLIKELY",
      "matched": []
    },
    {
      "name": "known stalkerware is confirmed",
      "facts": {
        "app.known_stalkerware_match": true
      },
      "confidence": "CONFIRMED",
      "matched": [
        "PSG-KNOWN-001"
      ]
    },
    {
      "name": "confirmed is never excused by an innocent explanation",
      "facts": {
        "app.known_stalkerware_match": true,
        "app.is_parental_control": true
      },
      "confidence": "CONFIRMED",
      "matched": [
        "PSG-KNOWN-001",
        "PSG-INNOCENT-002"
      ]
    },
    {
      "name": "an innocent rule that names a confirm rule still cannot explain it",
      "facts": {
        "app.known_stalkerware_match": true,
        "app.test_explains_confirm": true
      },
      "confidence": "CONFIRMED",
      "matched": [
        "PSG-KNOWN-001",
        "PSG-INNOCENT-004"
      ]
    },
    {
      "name": "hidden sideloaded screen access is very likely",
      "facts": {
        "app.accessibility_enabled": true,
        "app.has_launcher_icon": false,
        "app.install_source": "sideload"
      },
      "confidence": "VERY_LIKELY",
